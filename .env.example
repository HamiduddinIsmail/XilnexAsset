# Optional fallback if you skip the in-app Setup page.
# Setup (App ID, App Secret, Base link) is stored in data/lark-settings.json
# and takes precedence over these values for everyone using this server.

# Lark Open Platform app (custom app)
LARK_APP_ID=
LARK_APP_SECRET=

# International Lark. For Feishu China use https://open.feishu.cn
LARK_API_BASE=https://open.larksuite.com

# From the Base URL: https://<tenant>.larksuite.com/base/<APP_TOKEN>?table=<TABLE_ID>
# Wiki tokens starting with wik are resolved automatically.
LARK_APP_TOKEN=
LARK_BASE_URL=
LARK_TABLE_ID=
LARK_TABLE_NAME=Asset Register

# Optional. Auto-detected when omitted.
LARK_ASSET_NAME_FIELD=Asset Name
LARK_SERIAL_NUMBER_FIELD=Serial Number
